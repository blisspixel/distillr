# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
agent-dist/
build/
.eggs/

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# SBOM / dependency-export artifacts (generated in CI, uploaded as artifacts)
*.cdx.json
sbom-requirements.txt

# Test / coverage
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
mutants/
.mutmut-cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code / AI tooling project data
.claude/

# Kiro configuration and spec files
.kiro/

# Environment / secrets (never commit real keys)
.env
.env.local
.env.*
.env.*.local
!.env.example

# Distill runtime data (per-user, sometimes large)
/library/
output/
tmp/

# User-local files that should never ship (briefing contexts, custom seed files,
# client-specific configs, scratch notes, whatever). Put anything personal here
# and it stays out of git. Only private/README.md ships to explain the convention.
# The repo ships TEMPLATE/example files for each input kind elsewhere
# (docs/briefing-contexts/TEMPLATE.md, configs/example_seeds.json).
private/*
!private/README.md

# Reference material from other projects - not part of distillr
archive/

# Logs
*.log
terminals/

# Agent working files: cycle journal, state analysis, engineering recipes, and
# the self-review rubric. Local-only by convention so the public repo stays
# tidy; the shipped record of what changed lives in docs/CHANGELOG.md.
.agent/
docs/.agent/

# Dev and run logs
logs/
