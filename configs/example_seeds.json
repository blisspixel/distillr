{
  "_comment": "Seed file for `distill site-batch` / `distill ramp-up configs/example_seeds.json`. Copy this file, rename it, and replace the URLs below with pages you actually want to ingest. Use `distill site-batch ... --preview` to inspect the resolved plan before writing. Collections or URL objects can set mode to exact-page or shallow-crawl. Use crawl_prefix to keep shallow crawl links under a specific path branch.",
  "topic": "example",
  "crawl": {
    "max_depth": 1,
    "max_pages_per_seed": 4,
    "same_section_only": true
  },
  "collections": [
    {
      "name": "overview",
      "label": "Overview and positioning",
      "mode": "exact-page",
      "seeds": [
        "https://example.com/about",
        "https://example.com/products/overview",
        "https://example.com/research"
      ]
    },
    {
      "name": "docs",
      "label": "Product documentation",
      "mode": "shallow-crawl",
      "crawl_prefix": "/docs",
      "seeds": [
        "https://example.com/docs/introduction",
        "https://example.com/docs/architecture",
        "https://example.com/docs/api-reference"
      ]
    },
    {
      "name": "thought-leadership",
      "label": "Thought leadership and blog",
      "mode": "exact-page",
      "seeds": [
        "https://example.com/blog",
        "https://example.com/insights",
        "https://example.com/case-studies"
      ]
    }
  ]
}
