    "topic": "topics/Contract Topic",
    "topic_traversal_input": "topics/Escape",
    "topics": "topics",
    "video": "topics/Contract Topic/channels/Contract Channel/videos/video-id",
    "video_slug": "topics/Contract Topic/channels/Contract Channel/videos/contract-video_videoid",
    "videos": "topics/Contract Topic/channels/Contract Channel/videos"
