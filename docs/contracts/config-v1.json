  "rejection_cases": [
    {
      "field": "distill_cost_mode",
      "input": "free",
      "rejected": true
    },
    {
      "field": "distill_cost_warning_daily_usd",
      "input": 0,
      "rejected": true
    },
    {
      "field": "distill_cost_warning_daily_usd",
      "input": true,
      "rejected": true
    },
    {
      "field": "distill_cost_warning_daily_usd",
      "input": "inf",
