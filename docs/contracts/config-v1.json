    "relative_input_relative_to_root": "relative-library",
    "source_checkout_relative_to_root": "library"
  },
  "normalization_cases": [
    {
      "input": {
        "distill_cost_mode": " NO-METERED ",
        "distill_cost_warning_daily_usd": "12.5",
        "distill_cost_warning_run_spike_min_usd": "0",
        "distill_cost_warning_spike_multiplier": 3,
        "distill_cost_workflow_budgets": {
          "discover": 2.5,
          "report": 5
        }
      },
      "name": "cost_policy_and_budget_mapping",
      "normalized": {
        "distill_cost_mode": "no-metered",
        "distill_cost_warning_daily_usd": 12.5,
        "distill_cost_warning_run_spike_min_usd": 0.0,
        "distill_cost_warning_spike_multiplier": 3.0,
        "distill_cost_workflow_budgets": "discover=2.5,report=5"
      }
    },
    {
      "input": "report=5,discover=2.5",
      "name": "workflow_budget_string",
      "normalized": "discover=2.5,report=5"
    }
  ],
  "path_examples": {
