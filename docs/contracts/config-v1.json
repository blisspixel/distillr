  "schema": {
    "$defs": {
      "CostMode": {
        "enum": [
          "auto",
          "no-metered",
          "paid-ok"
        ],
        "type": "string"
      }
    },
    "properties": {
      "accordion_section_delay": {
        "default": 3,
        "type": "integer"
      },
      "accordion_section_model": {
        "default": "grok-4.6",
        "type": "string"
      },
      "anthropic_api_key": {
        "default": "",
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "distill_cost_mode": {
        "$ref": "#/$defs/CostMode",
        "default": "auto"
      },
      "distill_cost_warning_daily_usd": {
        "default": 10.0,
        "type": "number"
      },
      "distill_cost_warning_run_spike_min_usd": {
        "default": 1.0,
        "type": "number"
      },
      "distill_cost_warning_spike_multiplier": {
        "default": 2.5,
        "type": "number"
      },
      "distill_cost_workflow_budgets": {
        "default": "",
        "type": "string"
      },
      "distill_default_months": {
        "default": 1,
        "type": "integer"
      },
      "distill_mcp_ingest_allowlist": {
        "default": "",
        "type": "string"
      },
      "distill_mcp_max_spend_per_call": {
        "default": 0.0,
        "type": "number"
      },
      "distill_mcp_read_only": {
        "default": false,
        "type": "boolean"
      },
      "distill_output_dir": {
        "default": "<topology-dependent; see default cases>",
        "format": "path",
        "type": "string"
      },
      "distill_verify": {
        "default": "warn",
        "type": "string"
      },
      "gemini_api_key": {
        "default": "",
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "openai_api_key": {
        "default": "",
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "scribe_path": {
        "default": "",
        "type": "string"
      },
      "xai_analysis_model": {
        "default": "",
        "type": "string"
      },
      "xai_api_key": {
        "default": "",
        "format": "password",
        "type": "string",
        "writeOnly": true
      },
      "xai_fast_model": {
        "default": "grok-4.6",
        "type": "string"
      },
      "xai_premium_model": {
        "default": "grok-4.6",
        "type": "string"
      },
      "xai_rerank_model": {
        "default": "",
        "type": "string"
      },
      "xai_site_model": {
        "default": "grok-4.6",
        "type": "string"
      },
      "xai_synthesis_model": {
        "default": "",
        "type": "string"
      }
    },
    "type": "object"
  },
  "status": "freeze-ready"
}
